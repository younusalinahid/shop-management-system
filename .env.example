# PostgreSQL connection string. Leave unset for local development: the app then uses PGlite
# (Postgres in-process) stored in ./.data/pglite and applies migrations automatically.
# On Vercel, set this to your Neon / Supabase / any Postgres URL (use the pooled URL on serverless).
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Automatic daily backup (when the app runs on your own computer; ignored on Vercel).
# Folder for the backup files (default ./backups). A OneDrive / Google Drive folder gives an off-machine copy.
# AUTO_BACKUP_DIR=D:\ShopBackups
# How many daily backups to keep (default 30). Set AUTO_BACKUP=off to turn it off.
# AUTO_BACKUP_KEEP=30
